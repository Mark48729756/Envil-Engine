#version 450
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(binding=0) uniform samplerCube environmentMap;
layout(rgba16f,binding=1) writeonly uniform imageCube prefilteredMap;
layout(push_constant) uniform Params { uint faceSize; float roughness; uint sampleCount; } pc;
const float PI=3.14159265359;
vec3 faceDir(uint f,vec2 p){if(f==0)return normalize(vec3(1,-p.y,-p.x));if(f==1)return normalize(vec3(-1,-p.y,p.x));if(f==2)return normalize(vec3(p.x,1,p.y));if(f==3)return normalize(vec3(p.x,-1,-p.y));if(f==4)return normalize(vec3(p.x,-p.y,1));return normalize(vec3(-p.x,-p.y,-1));}
vec2 hammersley(uint i,uint n){uint b=bitfieldReverse(i);return vec2(float(i)/float(n),float(b)*2.3283064365386963e-10);}
vec3 importanceGGX(vec2 Xi,vec3 N,float r){float a=r*r,phi=2*PI*Xi.x;float cosT=sqrt((1-Xi.y)/(1+(a*a-1)*Xi.y));float sinT=sqrt(max(0,1-cosT*cosT));vec3 H=vec3(cos(phi)*sinT,sin(phi)*sinT,cosT);vec3 up=abs(N.z)<0.999?vec3(0,0,1):vec3(1,0,0);vec3 T=normalize(cross(up,N)),B=cross(N,T);return normalize(T*H.x+B*H.y+N*H.z);}
void main(){uvec3 id=gl_GlobalInvocationID;if(id.x>=pc.faceSize||id.y>=pc.faceSize||id.z>=6)return;vec3 N=faceDir(id.z,(vec2(id.xy)+0.5)/float(pc.faceSize)*2-1),V=N;vec3 sum=vec3(0);float w=0;for(uint i=0;i<pc.sampleCount;++i){vec3 H=importanceGGX(hammersley(i,pc.sampleCount),N,max(pc.roughness,0.001));vec3 L=normalize(2*dot(V,H)*H-V);float nl=max(dot(N,L),0);if(nl>0){sum+=textureLod(environmentMap,L,0).rgb*nl;w+=nl;}}imageStore(prefilteredMap,ivec3(id),vec4(sum/max(w,1e-5),1));}
