#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(rg16f,binding=0) writeonly uniform image2D brdfLut;
layout(push_constant) uniform Params { uint size; uint sampleCount; } pc;
const float PI=3.14159265359;
vec2 hammersley(uint i,uint n){return vec2(float(i)/float(n),float(bitfieldReverse(i))*2.3283064365386963e-10);}
vec3 sampleGGX(vec2 Xi,float rough){float a=rough*rough,phi=2*PI*Xi.x;float ct=sqrt((1-Xi.y)/(1+(a*a-1)*Xi.y));float st=sqrt(max(0,1-ct*ct));return vec3(cos(phi)*st,sin(phi)*st,ct);}
float geometrySchlick(float nd,float k){return nd/(nd*(1-k)+k);}
void main(){uvec2 id=gl_GlobalInvocationID.xy;if(any(greaterThanEqual(id,uvec2(pc.size))))return;vec2 uv=(vec2(id)+0.5)/float(pc.size);float NdotV=max(uv.x,0.001),rough=uv.y;vec3 V=vec3(sqrt(1-NdotV*NdotV),0,NdotV);float A=0,B=0;for(uint i=0;i<pc.sampleCount;++i){vec3 H=sampleGGX(hammersley(i,pc.sampleCount),rough);vec3 L=normalize(2*dot(V,H)*H-V);float nl=max(L.z,0),nh=max(H.z,0),vh=max(dot(V,H),0);if(nl>0){float k=rough*rough*0.5;float G=geometrySchlick(NdotV,k)*geometrySchlick(nl,k);float vis=G*vh/max(nh*NdotV,1e-5);float Fc=pow(1-vh,5);A+=(1-Fc)*vis;B+=Fc*vis;}}imageStore(brdfLut,ivec2(id),vec4(A/float(pc.sampleCount),B/float(pc.sampleCount),0,1));}
