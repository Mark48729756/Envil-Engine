#version 450
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(binding=0) uniform sampler2D equirectangularMap;
layout(rgba16f,binding=1) writeonly uniform imageCube environmentMap;
layout(push_constant) uniform Params { uint faceSize; } pc;
const float PI=3.14159265359;
vec3 faceDirection(uint face,vec2 uv){vec2 p=uv*2.0-1.0; if(face==0)return normalize(vec3(1,-p.y,-p.x));if(face==1)return normalize(vec3(-1,-p.y,p.x));if(face==2)return normalize(vec3(p.x,1,p.y));if(face==3)return normalize(vec3(p.x,-1,-p.y));if(face==4)return normalize(vec3(p.x,-p.y,1));return normalize(vec3(-p.x,-p.y,-1));}
void main(){uvec3 id=gl_GlobalInvocationID;if(id.x>=pc.faceSize||id.y>=pc.faceSize||id.z>=6)return;vec2 uv=(vec2(id.xy)+0.5)/float(pc.faceSize);vec3 d=faceDirection(id.z,uv);vec2 e=vec2(atan(d.z,d.x)/(2.0*PI)+0.5,asin(clamp(d.y,-1.0,1.0))/PI+0.5);imageStore(environmentMap,ivec3(id),texture(equirectangularMap,e));}
